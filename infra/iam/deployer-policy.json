{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationSam",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:615445513489:stack/nutriscan*/*",
        "arn:aws:cloudformation:ap-northeast-2:615445513489:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:ap-northeast-2:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "CloudFormationRead",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:ListStacks",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectServices",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "apigateway:*",
        "dynamodb:*",
        "sagemaker:*",
        "logs:*",
        "cloudwatch:*",
        "ecr:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" }
      }
    },
    {
      "Sid": "ProjectBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::nutriscan*",
        "arn:aws:s3:::nutriscan*/*",
        "arn:aws:s3:::aws-sam-cli-managed-default*",
        "arn:aws:s3:::aws-sam-cli-managed-default*/*"
      ]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ManageProjectRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::615445513489:role/nutriscan-*"
    },
    {
      "Sid": "PassOnlyProjectRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::615445513489:role/nutriscan-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "sagemaker.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyHelpers",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles",
        "servicequotas:Get*",
        "servicequotas:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
